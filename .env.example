# Supabase (local defaults come from `supabase start` output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in (P3). Only needed to exercise the real provider against the
# local stack; flip [auth.external.google].enabled in supabase/config.toml too.
# The hosted project configures Google in the Supabase dashboard instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# LLM (server-side only, never exposed to the client)
OPENAI_API_KEY=

# Analytics (M19)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public site URL, used for OG tags and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

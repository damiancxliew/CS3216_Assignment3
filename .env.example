# Supabase (local defaults come from `supabase start` output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional PostgREST data API; when unset, app data continues to use Supabase.
# Public PostgREST base URL, normally the site's Caddy origin.
NEXT_PUBLIC_DATA_URL=
# Public role token generated by infra/aws/gen-keys.mjs.
NEXT_PUBLIC_DATA_ANON_KEY=
# Server-only PostgREST service_role token generated by infra/aws/gen-keys.mjs.
DATA_SERVICE_ROLE_KEY=

# Optional S3 asset storage; unset keeps uploads in Supabase Storage.
# Private S3 bucket used for generated assets.
ASSET_BUCKET=
# AWS region hosting the asset bucket.
AWS_REGION=
# Public CloudFront URL used for stored asset links.
ASSET_PUBLIC_BASE_URL=
# Optional S3-compatible endpoint for local testing, such as MinIO.
AWS_ENDPOINT_URL_S3=

# AWS migration and standalone build settings.
# Postgres connection URL for the EC2 migration runner.
DATABASE_URL=
# PostgreSQL superuser password supplied during EC2 bootstrap.
POSTGRES_SUPERUSER_PASSWORD=
# Password assigned to the PostgREST authenticator database role.
AUTHENTICATOR_PASSWORD=
# Hosted Supabase database URL for the one-time copy script; never use for app queries.
SUPABASE_DB_URL=
# PostgREST database connection URL using the authenticator role.
PGRST_DB_URI=
# Public DNS name served by Caddy.
SITE_DOMAIN=
# Set to standalone only when building the EC2 deployment artifact.
NEXT_OUTPUT=
# Expose local password sign-in in standalone test builds only.
NEXT_PUBLIC_DEV_SIGN_IN=

# Shared secret used by the v3 jobs tick route and AWS timer.
# JOBS_TICK_SECRET=

# Google sign-in (P3). Only needed to exercise the real provider against the
# local stack; flip [auth.external.google].enabled in supabase/config.toml too.
# The hosted project configures Google in the Supabase dashboard instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# LLM (server-side only, never exposed to the client)
OPENAI_API_KEY=

# Analytics (M19)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional explicit analytics environment; AWS staging sets this at build time.
# NEXT_PUBLIC_APP_ENV=staging

# Public site URL, used for OG tags and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

{
  "name": "@adventure/generation",
  "version": "0.1.0",
  "private": true,
  "description": "Ingest, adventure spec v2 (I1), planner, asset pipeline and eval harness (D1-D8)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./spec": "./src/spec/index.ts",
    "./ingest": "./src/ingest/index.ts",
    "./planner": "./src/planner/index.ts",
    "./fixtures": "./src/fixtures.ts",
    "./llm": "./src/llm/index.ts",
    "./assets": "./src/assets/index.ts",
    "./play": "./src/play/index.ts",
    "./publish": "./src/publish/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./v3": "./src/v3/index.ts",
    "./sources-labels": "./src/sources/labels.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run schema:check",
    "schema": "vite-node scripts/write-json-schema.ts",
    "schema:check": "vitest run tests/json-schema.test.ts",
    "eval": "vite-node evals/run.ts --",
    "eval:v3-grounding": "vite-node evals/run-v3-grounding.ts --",
    "generate": "vite-node scripts/generate.ts --",
    "generate:v3": "vite-node scripts/generate-v3.ts --",
    "assets": "vite-node scripts/assets.ts --"
  },
  "dependencies": {
    "@adventure/spec-v3": "file:../spec-v3",
    "openai": "~7.15.0",
    "sharp": "0.35.4",
    "undici": "~6.29.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}

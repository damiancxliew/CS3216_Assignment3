{
  "name": "@adventure/game-client",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable settlement map playground client",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./view": "./src/view.ts",
    "./tiled-view": "./src/tiled-view.ts"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@adventure/game-core": "file:../game-core",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.21",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

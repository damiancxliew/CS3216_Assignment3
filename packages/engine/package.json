{
  "name": "@adventure/engine",
  "version": "0.1.0",
  "private": true,
  "description": "v3 gameplay engine: rules for discoveries, stances, defining moments and endings; plus a scripted mock",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mock": "./src/mock/index.ts"
  },

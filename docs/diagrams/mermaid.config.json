{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Inter, Arial, Helvetica, sans-serif",
    "fontSize": "16px",
    "background": "#ffffff",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#1f2933",
    "primaryBorderColor": "#b8c2cf",
    "secondaryColor": "#f4f6f8",
    "tertiaryColor": "#ffffff",
    "lineColor": "#8792a2",
    "textColor": "#1f2933",
    "clusterBkg": "#f6f7f9",
    "clusterBorder": "#e1e5ea",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#ffffff",
    "actorBorder": "#b8c2cf",
    "actorTextColor": "#1f2933",
    "actorLineColor": "#c9d0d9",
    "signalColor": "#6b7685",
    "signalTextColor": "#1f2933",
    "labelBoxBkgColor": "#f4f6f8",
    "labelBoxBorderColor": "#c9d0d9",
    "noteBkgColor": "#fff8e6",
    "noteBorderColor": "#ecd9a3",
    "noteTextColor": "#5c4a1a",
    "activationBkgColor": "#eef2f7",
    "activationBorderColor": "#b8c2cf",
    "sequenceNumberColor": "#ffffff"
  },
  "themeCSS": ".node rect, .node polygon, .node path, .node circle { stroke-width: 1.2px; } .node rect { rx: 8px; ry: 8px; } .cluster rect { rx: 10px; ry: 10px; stroke-width: 1px; } .cluster-label .nodeLabel, .cluster-label span { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #6b7685 !important; } .nodeLabel b { font-weight: 600; } .sub { font-size: 13.5px; color: #66707d; } .edgeLabel, .edgeLabel p, .edgeLabel span { font-size: 13.5px; color: #4f5966 !important; } .flowchart-link { stroke-width: 1.3px; } .actor { stroke-width: 1.2px; } .messageText { font-size: 15px !important; } .noteText { font-size: 14px !important; }",
  "flowchart": {
    "useMaxWidth": false,
    "htmlLabels": true,
    "curve": "basis",
    "wrappingWidth": 320,
    "nodeSpacing": 28,
    "rankSpacing": 42,
    "padding": 12,
    "diagramPadding": 16
  },
  "sequence": {
    "useMaxWidth": false,
    "wrap": true,
    "width": 150,
    "actorFontSize": 15,
    "messageFontSize": 15,
    "noteFontSize": 14,
    "actorFontFamily": "Inter, Arial, Helvetica, sans-serif",
    "messageFontFamily": "Inter, Arial, Helvetica, sans-serif",
    "noteFontFamily": "Inter, Arial, Helvetica, sans-serif",
    "boxMargin": 8,
    "messageMargin": 26,
    "mirrorActors": false,
    "showSequenceNumbers": false
  }
}

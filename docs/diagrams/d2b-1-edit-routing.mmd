%% D2b-1: routing a review-chat message to its edit base. Node notes: NOTES.md
flowchart TB
  MSG(["Teacher message"])
  MSG -->|draft| FA["findEditTargetsAction"]
  FA --> FET["findEditTargets"]
  FET -->|targets| SUG
  MSG -->|"paused pass"| SUG["suggestReviewChangeAction"]
  FA & SUG --> LT["loadReviewChatTarget"]
  LT --> BD["Saved draft"] & BP["Paused pass"]
  BD & BP --- DB[("Postgres")]
  SUG --> PROP["Propose and apply"]

  classDef actor fill:#eaf2ff,stroke:#8fb0e6
  classDef store fill:#fff6e5,stroke:#e3c27a
  class MSG actor
  class DB,BD,BP store

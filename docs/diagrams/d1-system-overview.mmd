%% D1: high-level system architecture. Node notes: NOTES.md
flowchart TB
  subgraph browser["Browser"]
    direction LR
    T["Teacher console"]
    S["Student play client"]
  end

  subgraph web["Next.js app"]
    direction LR
    PAGES["Pages and<br/>server actions"]
    GEN["Generation<br/>service"]
    TICK["Job tick"]
    TURN["Turn API"]
  end

  subgraph pkgs["Internal packages"]
    direction LR
    GP["generation"]
    JOBS["jobs"]
    ENG["engine"]
    SHARED["spec-v3<br/>play-contract"]
    GC["game-core<br/>game-client"]
  end

  subgraph infra["Data and external services"]
    direction LR
    LLM["LLM providers"]
    DEC["OpenAI<br/>Decisions API"]
    BKT@{ shape: trap-t, label: "Asset bucket" }
    DB[("Postgres")]
    AUTH["Supabase Auth"]
  end

  T --> PAGES
  S --> TURN
  PAGES --> GEN --> JOBS
  TICK --> GP
  TURN --> ENG
  GP --> LLM & DEC & BKT
  JOBS --> DB
  web --> DB
  browser -.->|sign in| AUTH

  classDef actor fill:#eaf2ff,stroke:#8fb0e6
  classDef store fill:#fff6e5,stroke:#e3c27a
  classDef ext fill:#f4effd,stroke:#b9a3e3
  class T,S actor
  class DB,BKT store
  class AUTH,LLM,DEC ext

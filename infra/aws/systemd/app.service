[Unit]
Description=Historical Adventures Next.js standalone application
After=network-online.target postgrest.service
Wants=network-online.target

[Service]
Type=simple
User=app
Group=app
WorkingDirectory=/opt/app/current
EnvironmentFile=/etc/app.env
EnvironmentFile=/etc/data-api.env
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStartPre=/opt/app/bin/check-isolation.sh
ExecStart=/usr/local/bin/node /opt/app/current/apps/web/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

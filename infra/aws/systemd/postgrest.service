[Unit]
Description=PostgREST API for the application database
After=network-online.target postgresql.service postgresql-16.service
Wants=network-online.target

[Service]
Type=simple
User=app
Group=app
WorkingDirectory=/opt/app/current
EnvironmentFile=/etc/postgrest.env
EnvironmentFile=/etc/data-api.env
Environment=PGRST_DB_SCHEMAS=public
Environment=PGRST_DB_ANON_ROLE=anon
Environment=PGRST_JWT_ROLE_CLAIM_KEY=.role
Environment=PGRST_SERVER_HOST=127.0.0.1
Environment=PGRST_SERVER_PORT=3001
ExecStart=/bin/bash -c 'export PGRST_JWT_SECRET="$(< /etc/postgrest/jwt-secret.json)"; exec /usr/local/bin/postgrest'
ExecStartPost=/bin/bash -c 'for ((attempt=0; attempt<30; attempt++)); do if /usr/bin/curl --fail --silent http://127.0.0.1:3001/ >/dev/null; then exit 0; fi; /usr/bin/sleep 1; done; echo "PostgREST did not become ready on 127.0.0.1:3001" >&2; exit 1'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

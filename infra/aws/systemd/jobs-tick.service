[Unit]
Description=Run one v3 jobs tick
After=app.service

[Service]
Type=oneshot
User=app
Group=app
EnvironmentFile=/etc/app.env
ExecStart=/bin/bash -c '[[ -n "$JOBS_TICK_SECRET" ]] || exit 0; printf "x-jobs-tick-secret: %%s\n" "$JOBS_TICK_SECRET" | /usr/bin/curl --fail --silent --show-error --max-time 330 -X POST -H @- http://127.0.0.1:3000/api/v3/jobs/tick'
